# Frontend environment for Invoxa (Vercel Hobby plan)
#
# Copy this file to `.env.local` for local development, or set the values in
# the Vercel project dashboard.  Never commit real secrets.

# Public URL of the deployed backend (Render).  Leave blank during local dev
# to fall back to relative URLs.
VITE_API_BASE_URL=

# Supabase project values (publishable key only - safe for the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
