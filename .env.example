# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWKS_URL=

# Gemini (fallback only)
GEMINI_API_KEY=

# Agent limits (optional; defaults to 240 model calls/day, resets midnight IST)
# AGENT_DAILY_GEMINI_CALLS=240
# AGENT_MAX_TOOL_ROUNDS=8
# AGENT_MAX_MODEL_CALLS=10

# Per-endpoint rate limits (optional; requests per hour per account)
# RATE_LIMIT_UPLOAD_PER_HOUR=60
# RATE_LIMIT_EXTRACT_PER_HOUR=60
# RATE_LIMIT_AGENT_PER_HOUR=60
# RATE_LIMIT_EMAIL_PER_HOUR=10

# Weekly digest email (optional; a Gmail app password works)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=me@gmail.com
# SMTP_PASSWORD=your-app-password
# DIGEST_FROM=me@gmail.com

# Log level (optional; INFO by default)
# LOG_LEVEL=INFO

# Database (if needed for CLI migrations)
DATABASE_URL=
